# Use an isolated migrated database for Preview; never reuse Production credentials.
# See docs/security/preview-configuration.md.
# Database Connection (PostgreSQL on Supabase / Neon / Vercel Postgres)
DATABASE_URL="postgresql://user:password@host:port/database"

# Required at runtime for sessions and inquiry rate limits; independently generate per environment.
# JWT Secret for Admin Session Signing
JWT_SECRET="" # generate with: openssl rand -base64 48

# Email Notifications (Optional - Gmail / SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="jalal611@gmail.com"
SMTP_PASS=""
NOTIFICATION_EMAIL="jalal611@gmail.com"

# Public HTTPS origin for this environment (metadata and sitemap)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
